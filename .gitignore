/.idea/
/*.iml

/vendor/
/vendor-bin/*/vendor/

/.php-cs-fixer.cache
/tests/.phpunit.cache

/node_modules/

# The release signature. occ integrity:sign-app writes it into the release
# archive only. A copy in git does not match the current files, and Nextcloud
# then reports integrity errors for an app installed from git.
/appinfo/signature.json
# composer.lock and vendor-bin/*/composer.lock are committed for reproducible
# CI (the dependency set is dev/CI tooling only; nothing ships in vendor/).
/package-lock.json
